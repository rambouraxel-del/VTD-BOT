# Développement local du front uniquement (npm run dev).
# Copier en .env.local pour utiliser le pont API au lieu des mocks.
# mock (défaut) = données fictives locales ; api = pont API (server/api.py)
VITE_DATA_SOURCE=api
# Vide = même origine (le proxy Vite redirige /api vers http://127.0.0.1:8787 en dev)
VITE_API_URL=
