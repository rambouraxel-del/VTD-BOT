# =============================================================================
#  Collector VTD (PC Windows) — copier en .env puis remplir.
#  Le fichier .env n'est JAMAIS commité.
# =============================================================================

# Adresse HTTPS du VPS (le même domaine que l'app), sans / final.
# Test local sans VPS (profil « local ») : VTD_API_URL=http://api:8787
VTD_API_URL=https://ton-domaine.example

# Clé d'ingestion : la MÊME valeur que INGEST_KEY dans le .env du VPS.
# Différente de API_KEY (la clé de l'app). 32 caractères minimum.
INGEST_KEY=

# Pause entre deux passages sur les 4 recherches (secondes, minimum 60).
INTERVAL_SECONDS=180

# En cas de refus / challenge Vinted : pause de BACKOFF_MINUTES, doublée à
# chaque nouveau refus, jusqu'à MAX_BACKOFF_MINUTES. Jamais de contournement.
BACKOFF_MINUTES=15
MAX_BACKOFF_MINUTES=120

# Navigateur annoncé à Vinted (un seul, fixe) et langue.
USER_AGENT=
ACCEPT_LANGUAGE=fr-FR,fr;q=0.9

# Clé API de l'app pour le test local uniquement (profil « local »).
LOCAL_API_KEY=local-test-api-key-0123456789abcdef
