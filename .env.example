# =============================================================================
#  VTD Deals — configuration du déploiement (docker compose)
#  Copier en .env :   cp .env.example .env    (ou ./scripts/setup.sh)
#  Le fichier .env n'est JAMAIS commité (voir .gitignore).
# =============================================================================

# --- Domaine -----------------------------------------------------------------
# Nom de domaine qui pointe vers l'IP du VPS (enregistrement DNS de type A).
# "localhost" = test local avec certificat auto-signé.
DOMAIN=localhost

# --- Sécurité du pont API ----------------------------------------------------
# Clé secrète OBLIGATOIRE (32 caractères minimum). Générer avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# Vide = même domaine uniquement (cas normal : la PWA est servie par Caddy).
# Ex. pour autoriser aussi une PWA hébergée ailleurs : https://exemple.github.io
CORS_ORIGINS=

# --- Source des annonces -----------------------------------------------------
# s4mh = lit la base de s4mh ; mock = 12 annonces fictives du pont (s4mh ignoré)
VTD_SOURCE=s4mh
# 1 = seulement les annonces retenues par s4mh ; 0 = toutes (utile en test)
S4MH_ACCEPTED_ONLY=0

# --- s4mh/vinted-bot ---------------------------------------------------------
# Arguments de lancement de s4mh.
#   --mode test   : annonces SIMULÉES, aucune requête vers Vinted (défaut)
#   --no-discord  : pas d'alertes Discord (la PWA suffit)
# Mode réel (plus tard, volontairement) : S4MH_ARGS=--mode live --no-discord
S4MH_ARGS=--mode test --no-discord
# Version de s4mh (commit GitHub). Changer pour mettre s4mh à jour.
S4MH_REF=4ff42de4dfe7d43e306b743d6e00f7713ef7e811
S4MH_LOG_LEVEL=INFO
# Optionnel : bot Discord de s4mh (laisser vide si --no-discord)
DISCORD_TOKEN=

TZ=Europe/Paris
